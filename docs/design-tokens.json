    "cssSource": "frontend/src/styles/design-tokens.css",
    "register": "product",
    "designScale": { "variance": 3, "motion": 3, "density": 4 },
    "colorArchetype": "color-palettes.md 第 29 套「保险安全蓝绿」（结构原型，色值由 04 覆盖）",
    "typographyArchetype": "typography-pairings.md 第 5 套 Minimal Swiss + 第 22 套 Chinese Simplified",
    "iconContract": "lucide-react==1.47.0（严格描边 SVG，MIT，版本等号锁死）；尺寸 16/20/24px，描边 1.75，currentColor 取色；经 components/common/Icon 单一入口，业务禁直接 import 图标库",
    "darkMode": "已实现 4 个可选主题（night 夜航灯 / black 纯黑 / sepia 米黄纸 / pine 松林）+ 默认主题 light（等于不写 data-theme）。切换逻辑见 frontend/src/lib/theme.ts，选择器见 frontend/src/components/config/ThemeSwitcher.tsx。",
    "themesContract": "见下方 themes 段。色值唯一真相源是同源的 design-tokens.css；本段只登记「有哪些主题」，不复制色值，避免双真源。",
    "notes": "本文件与 design-tokens.css 同源。所有颜色只在该 CSS 里定义（含各主题覆盖块），组件禁止硬编码色值。加主题时必须同步本文件 themes 段，并跑 npm run check:theme 验证。"
  },

  "themes": {
    "$meta": "主题登记表：只登记 id 与对应的 CSS 覆盖块选择器。色值在 design-tokens.css，标签与色卡预览在 frontend/src/lib/theme.ts。npm run check:theme 会校验本段与 CSS 里的主题块一一对应。",
    "default": "light",
    "defaultNote": "light 是默认主题，等于「不写 data-theme」，其色值就是本文件 color 段描述的那一套。",
    "list": [
      { "id": "night", "label": "夜航灯", "scheme": "dark", "cssSelector": ":root[data-theme='night']", "hint": "夜间写稿主推，深灰蓝低眩光" },
      { "id": "black", "label": "纯黑", "scheme": "dark", "cssSelector": ":root[data-theme='black']", "hint": "OLED 省电、对比最高" },
      { "id": "sepia", "label": "米黄纸", "scheme": "light", "cssSelector": ":root[data-theme='sepia']", "hint": "纸质书暖色，长时阅读眼压最低" },
      { "id": "pine", "label": "松林", "scheme": "light", "cssSelector": ":root[data-theme='pine']", "hint": "低饱和绿灰，缓解屏幕发白" }
    ]
  },

