# ============================================================================
# AI 小说创作工具 · 版本控制忽略清单
# ----------------------------------------------------------------------------
# 目标：让「克隆下来的仓库」足够干净 —— 只留源码、文档与前端构建产物，
# 体积大且可再生的东西一律不进仓库。
# ============================================================================

# --- 运行环境（换电脑时由 bootstrap.py 自动重建） ----------------------------
.venv/
.venv.broken*/
.venv-local/

# 前端依赖（只有要改前端代码时才需要；运行阶段完全不需要 Node.js，
# 因为构建产物 dist/ 已随仓库分发）
node_modules/
frontend/node_modules/

# --- 编译 / 缓存产物 --------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.pytest_cache/
frontend/vite.config.ts.timestamp-*.mjs

# --- 运行时状态（每次启动自动生成） -----------------------------------------
data/logs/
data/instance.lock
data/active_book.json
data/app.db
data/app.db-wal
data/app.db-shm

# --- 用户数据（不进版本库：稿件属于用户，且是二进制库） ---------------------
# 说明：作品库 novel.db 用 WAL 模式，会带 -wal / -shm 两个伴生文件，
#      整目录备份/迁移时必须一起拷，只拷 .db 会丢最近的事务。
books/*/novel.db
books/*/novel.db-wal
books/*/novel.db-shm
# meta.json 含书名 / 题材 / 一句话卖点 —— 属于用户内容，按文件头「稿件属于用户」
# 的声明同样不应进版本库（此前只忽略了 novel.db，一次 `git add -A` 就会把作品 meta 提交）。
books/*/meta.json
books/*/exports/
.recycle/

# --- 敏感内容（来源不明的词表会带来「假安全感」，故不分发） -----------------
data/sensitive_words.txt

# --- 本地临时 / 迁移残留 ----------------------------------------------------
.cleanup_*/
*.broken

# --- 开发过程产物（构建/lint/测试的一次性输出，一律不进仓库） ----------------
/_*.*
/frontend/_*.*
/frontend/src/_*.*
/backend/_*.*
